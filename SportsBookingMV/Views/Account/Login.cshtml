@{
    ViewData["Title"] = "Member Login";
}

<div class="auth-wrapper">

    <div class="auth-card">

        <div class="text-center mb-4">

            <div class="booking-icon mx-auto mb-3">
                🏆
            </div>

            <h2>Welcome back</h2>

            <p class="text-secondary">
                Sign in to manage your sports bookings.
            </p>

        </div>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            <div class="mb-3">

                <label class="form-label">
                    Email Address
                </label>

                <input type="email"
                       name="email"
                       class="form-control"
                       placeholder="you@example.com"
                       required />

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Password
                </label>

                <input type="password"
                       name="password"
                       class="form-control"
                       placeholder="Enter your password"
                       required />

            </div>

            <button type="submit"
                    class="btn btn-sports w-100">

                Sign In →

            </button>

        </form>

        <div class="text-center mt-4">

            <span class="text-secondary">
                Don't have an account?
            </span>

            <a asp-controller="Account"
               asp-action="Register"
               class="fw-bold text-decoration-none">

                Create one

            </a>

        </div>

    </div>

</div>