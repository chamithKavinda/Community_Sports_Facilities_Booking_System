<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SportsBooking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg sports-navbar">
            <div class="container">

                <a class="navbar-brand brand-logo"
                   asp-controller="Home"
                   asp-action="Index">

                    Sports<span class="brand-dot">Booking</span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto ms-lg-5">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Facility"
                               asp-action="Search">
                                Find Facilities
                            </a>
                        </li>

                        @if (Context.Session.GetString("MemberName") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Facility"
                                   asp-action="Search">
                                    My Bookings
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav align-items-lg-center">

                        @if (Context.Session.GetString("MemberName") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    👋 @Context.Session.GetString("MemberName")
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-login"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Sign Out
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-login"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Sign In
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="nav-link nav-register"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Join Now
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>
        </nav>
    </header>

    <main>

        @if (TempData["Success"] != null)
        {
            <div class="container mt-4">
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="container mt-4">
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            </div>
        }

        @RenderBody()

    </main>

    <footer class="sports-footer">

        <div class="container">

            <div class="row g-4">

                <div class="col-md-6">

                    <div class="footer-brand">
                        Sports<span>Booking</span>
                    </div>

                    <p class="mt-3">
                        Find. Book. Play.
                        Your community sports facility platform.
                    </p>

                </div>

                <div class="col-md-3">

                    <h5>Explore</h5>

                    <div class="mt-3">
                        <a class="text-decoration-none text-white-50 d-block mb-2"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>

                        <a class="text-decoration-none text-white-50 d-block"
                           asp-controller="Facility"
                           asp-action="Search">
                            Facilities
                        </a>
                    </div>

                </div>

                <div class="col-md-3">

                    <h5>Account</h5>

                    <div class="mt-3">

                        <a class="text-decoration-none text-white-50 d-block mb-2"
                           asp-controller="Account"
                           asp-action="Login">
                            Sign In
                        </a>

                        <a class="text-decoration-none text-white-50 d-block"
                           asp-controller="Account"
                           asp-action="Register">
                            Register
                        </a>

                    </div>

                </div>

            </div>

            <hr class="border-secondary my-4" />

            <small>
                © @DateTime.Now.Year SportsBooking. All rights reserved.
            </small>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>